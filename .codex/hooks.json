{
  "description": "Codex adapters for the shared hooks maintained under .claude/hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/run-shared-hook.sh\" .claude/hooks/pre-bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/run-shared-hook.sh\" .claude/hooks/protect-config.sh",
            "statusMessage": "Checking if file is a protected config..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/run-shared-hook.sh\" .claude/hooks/post-bash-pr.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/run-shared-hook.sh\" .claude/hooks/docs-lifecycle-guard.sh",
            "statusMessage": "Checking doc placement..."
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/run-shared-hook.sh\" .claude/hooks/post-lint.sh",
            "statusMessage": "Running lint on edited file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/run-shared-hook.sh\" .claude/hooks/stop-verify.sh",
            "statusMessage": "Running lint + test verification before completion..."
          }
        ]
      }
    ]
  }
}
