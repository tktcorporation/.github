{
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // mise shims resolve the tool version from the nearest .mise.toml, for every process in the container, including IDEs and hook runners.
  // containerEnv cannot expand ${containerEnv:PATH}; keep the image's standard executable paths explicitly.
  "containerEnv": {
    "PATH": "/home/vscode/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },

  // Volume name must start with [a-zA-Z0-9] to comply with Docker naming rules
  // Using 'devcontainer-' prefix so ${localWorkspaceFolderBasename} ('.github') doesn't start the name
  "mounts": [
    "source=devcontainer-${localWorkspaceFolderBasename}-pnpm-store,target=${containerWorkspaceFolder}/.pnpm-store,type=volume",

    // Claude Code データ永続化 (会話履歴・設定)
    // ~/.claude 全体を named volume にすることで、rebuild しても会話履歴が残る
    // 会話履歴: ~/.claude/projects/<path>/*.jsonl
    // 認証はコンテナ内で `claude login` して取得する（ホストの macOS Keychain は使えないため）
    // ログイン後の ~/.claude.json は volume 外だが、postStartCommand で volume 内にバックアップされる
    "source=devcontainer-${localWorkspaceFolderBasename}-claude-data,target=/home/vscode/.claude,type=volume",

    // mise インストール済みツールを DevContainer 間で共有
    // 全コンテナが Linux なのでバイナリ互換性あり。ワークスペース名を含めず共有 volume にする
    // ホスト (macOS) とは OS が異なるためバインドマウントではなく named volume を使う
    "source=devcontainer-shared-mise-data,target=/home/vscode/.local/share/mise,type=volume"
  ],
  "features": {
    // "ghcr.io/devcontainers/features/docker-in-docker:2": {
    //   "version": "latest",
    //   "enableNonRootDocker": "true",
    //   "moby": "true"
    // },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/mise:1": {
      "version": "2026.8.14"
    }
  },
  "runArgs": ["--env-file", ".devcontainer/.env.devcontainer"],
  "customizations": {
    "vscode": {
      "extensions": [
        "mhutchie.git-graph",
        "editorconfig.editorconfig",
        "WakaTime.vscode-wakatime",
        "nemesv.copy-file-name"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/.git/modules/**": true,
          "**/node_modules/**": true,
          "**/.pnpm/**": true,
          "**/.pnpm-store/**": true,
          "**/.turbo/**": true,
          "**/dist/**": true,
          "**/.next/**": true,
          "**/__pycache__/**": true,
          "**/.pytest_cache/**": true,
          "**/venv/**": true,
          "**/.venv/**": true,
          // Claude Code の並列作業で .worktrees/ 内に作成されるワークスペースが
          // VS Code の Git 拡張に検知されてメモリを大量消費するのを防ぐ
          "**/.worktrees/**": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/.pnpm": true,
          "**/.pnpm-store": true,
          "**/.git": true,
          "**/.turbo": true,
          "**/dist": true,
          "**/.next": true,
          "**/coverage": true,
          "**/.worktrees": true
        },
        "git.detectSubmodulesLimit": 0,
        // jj workspace が VS Code の Git 拡張に自動検出されるのを防ぐ
        // "openEditors" に設定すると、開いたファイルのリポジトリのみ追跡する
        "git.autoRepositoryDetection": "openEditors",
        // バックグラウンドの定期 fetch を無効化（メモリ・CPU 削減）
        "git.autoFetch": false,
        // ファイルツリーの Git 差分色付け計算を省略（大きいリポジトリで効果大）
        "git.decorations.enabled": false
      }
    }
  },
  "onCreateCommand": {
    "install-packages": [
      "bash",
      "-c",
      "set -e; sudo apt-get update && sudo apt-get install -y build-essential fzf ripgrep bc gpg ca-certificates curl tmux"
    ],
    // Docker は深いパスへ volume を mount すると、存在しない親ディレクトリも root 所有で作る。
    // ~/.local/share/mise の兄弟へツールを追加できるよう、XDG の親ディレクトリ自体を
    // vscode ユーザー所有にした上で、named volume の中身だけを再帰的に補正する。
    // 対象の named volume:
    //   .pnpm-store: pnpm のパッケージキャッシュ
    //   ~/.local/share/mise: mise のインストール済みツール
    //   ~/.claude: Claude Code データ全体
    "fix-volume-permissions": [
      "bash",
      "-c",
      "set -e; uid=$(id -u); gid=$(id -g); sudo install -d -o \"$uid\" -g \"$gid\" \"$HOME/.local\" \"$HOME/.local/share\" \"$HOME/.local/state\" \"$HOME/.cache\" \"$HOME/.local/share/pnpm\" \"$HOME/.local/state/mise\" \"$HOME/.cache/mise\"; sudo chown -R \"$uid:$gid\" \"$PWD/.pnpm-store\" \"$HOME/.local/share/mise\" \"$HOME/.claude\""
    ]
  },
  "updateContentCommand": {
    "add-node-gpg-key-mise": [
      "bash",
      "-c",
      "set -e; curl -fsSL https://raw.githubusercontent.com/nodejs/release-keys/b362bd15f2ac7ce350d7563fc03e0c625e455e5f/cli.sh | bash -s import"
    ],
    "setup-mise-shell": [
      "bash",
      "-c",
      "grep -qxF 'eval \"$(mise activate bash --shims)\"' ~/.bash_profile 2>/dev/null || echo 'eval \"$(mise activate bash --shims)\"' >> ~/.bash_profile; grep -qxF 'eval \"$(mise activate bash)\"' ~/.bashrc 2>/dev/null || echo 'eval \"$(mise activate bash)\"' >> ~/.bashrc"
    ]
    // Bun を使うセットアップは、mise install の完了後に実行する必要があるため postCreateCommand に置く。
    // updateContentCommand の object 内は並列実行されるので、ここから起動すると setup-mise-shell と競合する。
  },
  "postCreateCommand": {
    "fix-pnpm-store-permissions": ["bash", "-c", "sudo chown -R $(whoami) .pnpm-store"],
    // vp の Node マネージャを system-first モードにする（Node/グローバルツールは mise に一任する方針）。
    // mise を shadow し得るのは vp の node/npm/npx shim（= Node マネージャ管轄）で、vp は既定で pnpm の
    // shim を作らないため pnpm 自体は mise のまま奪われない。
    // `vp env off` を入れておくと、shim が存在しても system(mise) の Node を優先し、無い時だけ vp 管理版へ fallback する。
    // スコープ注意: `vp env off` が効くのは node/npm/npx shim の解決のみで、vp 自身のサブコマンド内部の
    // Node 解決には及ばない（upstream の既知の制約）。`vp dev`/`build`/`test`/`lint`/`fmt` 用途では実害なし。
    // 実行 Node が mise に切り替わるには mise install 完了が前提。
    // 注意: 再生成の主因である `vp install -g <pkg>` は使わず、グローバル CLI は .mise.toml に集約すること。
    "git-performance": "git config status.submoduleSummary false && git config diff.ignoreSubmodules all && git config fetch.recurseSubmodules false && git config submodule.recurse false",
    "install-gh-extensions": "gh extension install agbiotech/gh-sub-issue 2>/dev/null || true",
    // postCreateCommand の object 内は並列実行される。mise の trust/install/upgrade、Bun を使う初期設定、
    // Vite+ の切り替えを同一コマンドにまとめ、fresh container でも依存順を保証する。
    // lifecycle command では login shell を使わず、構築途中の .bash_profile を読み込まない。
    "mise-and-project-setup": [
      "bash",
      "-c",
      "mise trust && mise install && mise upgrade && mise exec -- bun .devcontainer/setup-git-user.ts && mise exec -- bun .devcontainer/setup-herdr.ts && vp env off"
    ],
    // ~/.claude.json は volume 外（ホームディレクトリ直下）のため、rebuild で消える
    // volume 内のバックアップからリストアする（postStartCommand で毎回バックアップされる）
    // 初回（バックアップなし）は onboarding 済みの最小ファイルを作成
    "restore-claude-json": [
      "bash",
      "-c",
      "test -f ~/.claude/.claude.json.bak && cp ~/.claude/.claude.json.bak ~/.claude.json || test -f ~/.claude.json || echo '{\"hasCompletedOnboarding\":true}' > ~/.claude.json"
    ]
  },
  "postStartCommand": {
    // ~/.claude.json を volume 内にバックアップ（認証情報の永続化）
    // コンテナ内で claude login した後の OAuth セッションを rebuild 後も保持するため
    // 有効な認証（oauthAccount）が含まれている場合のみバックアップする
    "backup-claude-json": [
      "bash",
      "-c",
      "grep -q 'oauthAccount' ~/.claude.json 2>/dev/null && cp ~/.claude.json ~/.claude/.claude.json.bak || true"
    ],
    "setup-chrome-devtools-mcp": [
      "mise",
      "exec",
      "--",
      "bun",
      ".devcontainer/setup-chrome-devtools-mcp.ts"
    ],
    // mise のツール更新は postCreateCommand の mise install/upgrade に集約する。
    // postStartCommand で upgrade すると、並列実行中の mise exec とインストール先が競合する。
    "check-env-file": [
      "bash",
      "-c",
      "[ -s .devcontainer/.env.devcontainer ] || echo 'WARNING: .devcontainer/.env.devcontainer is empty or missing. Secrets are not loaded.'"
    ]
  },
  // initializeCommand はホスト側で実行される
  // .env.devcontainer が無ければ空ファイルを作成（runArgs --env-file の失敗防止）
  "initializeCommand": "touch .devcontainer/.env.devcontainer"
}
